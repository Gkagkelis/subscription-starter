# ============================================================
# Greek Synthetic Research Lab — μεταβλητές περιβάλλοντος
# Αντιγράψτε τις χρήσιμες γραμμές στο .env.local (ΠΟΤΕ πραγματικά κλειδιά στο git).
# ============================================================

# Πού αποθηκεύονται μελέτες, focus groups, imports (ιδιωτικά, gitignored).
# Προεπιλογή: <project>/.synthetic-lab-data
SYNTHETIC_LAB_DATA_DIR=

# Σε παραγωγή: απαιτεί σύνδεση (Supabase auth της εφαρμογής) για σελίδες και API του Lab.
SYNTHETIC_LAB_REQUIRE_LOGIN=false

# ---------------- Live mode (AI) — ΑΠΕΝΕΡΓΟ από προεπιλογή ----------------
# Ενεργοποιείται μόνο αν ισχύουν ΚΑΙ τα τρία: true + ANTHROPIC_API_KEY + SYNTHETIC_LAB_LIVE_KEY
SYNTHETIC_LAB_LIVE_AI=false
# Κλειδί development με όριο δαπάνης στο Anthropic Console.
ANTHROPIC_API_KEY=
# Μυστικό που πληκτρολογεί ο ερευνητής στο UI (header x-synthetic-lab-key).
SYNTHETIC_LAB_LIVE_KEY=
# claude-opus-5-5 (προεπιλογή) | claude-sonnet-5-5 | claude-haiku-5-5
SYNTHETIC_LAB_MODEL=claude-opus-5-5
# Όρια
SYNTHETIC_LAB_MAX_AGENTS=30
SYNTHETIC_LAB_MAX_CONCURRENCY=3
SYNTHETIC_LAB_COST_CAP_USD=1
SYNTHETIC_LAB_DAILY_CAP_USD=5
SYNTHETIC_LAB_RUNS_PER_HOUR=10

# ---------------- Άδειες δεδομένων ----------------
# research (προεπιλογή): φορτώνονται και δεδομένα «μόνο για έρευνα» από
#   .synthetic-lab-data/research/ (π.χ. διαΝΕΟσις), με σήμανση σε UI/αναφορές.
# commercial: τα δεδομένα ερευνητικής βαθμίδας ΔΕΝ φορτώνονται.
SYNTHETIC_LAB_LICENSE_MODE=research
