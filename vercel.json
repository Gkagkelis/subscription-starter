      "path": "/api/ingest?token=dev",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/radar-tick",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/advisor/strategy-brief-precompute",
